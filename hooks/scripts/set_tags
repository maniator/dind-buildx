#!/bin/sh -x

# buildx tags look like `v0.35.0`; take the latest non-prerelease and drop the `v`.
BUILDX_VERSION=$(curl -s 'https://api.github.com/repos/docker/buildx/releases' | jq -r '[ .[] | select(.prerelease == false and .draft == false) | .tag_name ][0]' | sed -e 's/^v//')
# moby publishes several release series (docker-vX, client/vX, api/vX); Docker Engine
# releases are tagged `docker-vX.Y.Z`, so filter to those and strip the `docker-v` prefix.
DOCKER_VERSION=$(curl -s 'https://api.github.com/repos/moby/moby/releases' | jq -r '[ .[] | select(.prerelease == false and .draft == false) | .tag_name | select(startswith("docker-v")) ][0]' | sed -e 's/^docker-v//')
DOCKER_TAG=docker_$DOCKER_VERSION-buildx_$BUILDX_VERSION

DOCKER_LABEL=latest

if docker pull "docker:$DOCKER_VERSION" 2>/dev/null && docker pull "docker/buildx-bin:$BUILDX_VERSION" 2>/dev/null;
then
    echo "docker:$DOCKER_VERSION and buildx:$BUILDX_VERSION exist"
else
    echo "docker:$DOCKER_VERSION or buildx:$BUILDX_VERSION doesn't exist"
    DOCKER_TAG=$DOCKER_LABEL
    DOCKER_VERSION=latest
    BUILDX_VERSION=latest
fi

cat <<EOF > docker-bake.ci.hcl
variable "DOCKER_META_VERSION" { default="" }

group "default" {
    targets = ["ci_build"]
}

target "ci_build" {
  inherits = ["build", "docker-metadata-action"]
  tags = [
    "ghcr.io/maniator/dind-buildx:$DOCKER_TAG",
    "ghcr.io/maniator/dind-buildx:$DOCKER_LABEL",
    "ghcr.io/maniator/dind-buildx:\${DOCKER_META_VERSION}",
    "maniator/dind-buildx:$DOCKER_TAG",
    "maniator/dind-buildx:$DOCKER_LABEL",
    "maniator/docker-with-buildx:$DOCKER_TAG",
    "maniator/docker-with-buildx:$DOCKER_LABEL"
  ]
}
EOF

# Fall back to stdout when not running inside GitHub Actions (GITHUB_OUTPUT unset).
{
  echo "buildx_version=$BUILDX_VERSION"
  echo "docker_version=$DOCKER_VERSION"
} >> "${GITHUB_OUTPUT:-/dev/stdout}"
